{
  "name": "familie-ba-sak-frontend",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.15.0",
  "main": "backend/server.js",
  "repository": "https://github.com/navikt/familie-ba-sak-frontend.git",
  "author": "Team BAKS",
  "license": "MIT",
  "scripts": {
    "start": "pnpm start:backend:prod",
    "start:dev": "pnpm start:lokalt-mot-preprod",
    "start-env": "pnpm miljøvariabler && pnpm build:backend && ENV=\"$ENV\" pnpm start:backend:dev",
    "start:lokal": "ENV=lokal pnpm start-env",
    "start:hybrid": "ENV=hybrid pnpm start-env",
    "start:lokalt-mot-preprod": "ENV=lokalt-mot-preprod pnpm start-env",
    "start:backend:dev": "NODE_ENV=development node dist_backend/server.js",
    "start:backend:prod": "NODE_ENV=production ENV=prod node dist_backend/server.js",
    "miljøvariabler": "./hent-og-lagre-miljøvariabler.sh",
    "build": "pnpm build:prod",
    "build:dev": "NODE_ENV=development pnpm build:backend && pnpm build:frontend --mode lokalt-mot-preprod",
    "build:preprod": "NODE_ENV=production pnpm build:backend && pnpm build:frontend --mode preprod",
    "build:prod": "NODE_ENV=production pnpm build:backend && pnpm build:frontend --mode prod",
    "build:backend": "tsc -p src/backend/tsconfig.json && node scripts/prune-backend-node-modules.js",
    "build:frontend": "vite build src/frontend",
    "test": "vitest",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p src/backend/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json",
    "validate": "pnpm typecheck && pnpm lint && pnpm format"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.21.0",
    "@nais/apm": "0.6.0",
    "@navikt/aksel-icons": "8.16.1",
    "@navikt/ds-css": "8.16.1",
    "@navikt/ds-react": "8.16.1",
    "@navikt/ds-tokens": "8.16.1",
    "@navikt/familie-backend": "10.1.27",
    "@navikt/familie-form-elements": "22.0.2",
    "@navikt/familie-header": "17.0.4",
    "@navikt/familie-http": "8.0.24",
    "@navikt/familie-ikoner": "9.1.5",
    "@navikt/familie-logging": "7.0.8",
    "@navikt/familie-skjema": "8.2.50",
    "@navikt/familie-tidslinje": "11.0.3",
    "@navikt/familie-typer": "8.0.6",
    "@navikt/flagg-ikoner": "15.1.7",
    "@navikt/fnrvalidator": "2.2.1",
    "@navikt/land-verktoy": "15.1.7",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-virtual": "3.14.10",
    "axios": "1.19.0",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dayjs": "1.11.23",
    "deep-equal": "2.2.3",
    "express": "5.2.1",
    "http-proxy-middleware": "4.2.0",
    "lodash": "4.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "8.3.0",
    "styled-components": "6.5.3",
    "tslib": "2.8.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@axe-core/react": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/deep-equal": "1.0.4",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vercel/nft": "1.10.2",
    "@vitejs/plugin-react": "6.0.5",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "msw": "2.15.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
