{
    "name": "familie-ba-sak-frontend",
    "type": "module",
    "version": "0.0.1",
    "packageManager": "pnpm@11.15.0",
    "main": "backend/server.js",
    "repository": "https://github.com/navikt/familie-ba-sak-frontend.git",
    "author": "Team BAKS",
    "license": "MIT",
    "scripts": {
        "start": "pnpm start:backend:prod",
        "start:dev": "pnpm start:lokalt-mot-preprod",
        "start-env": "pnpm miljøvariabler && pnpm build:backend && ENV=\"$ENV\" pnpm start:backend:dev",
        "start:lokal": "ENV=lokal pnpm start-env",
        "start:hybrid": "ENV=hybrid pnpm start-env",
        "start:lokalt-mot-preprod": "ENV=lokalt-mot-preprod pnpm start-env",
        "start:backend:dev": "NODE_ENV=development node dist_backend/server.js | pino-pretty --messageKey=message",
        "start:backend:prod": "NODE_ENV=production ENV=prod node dist_backend/server.js",
        "miljøvariabler": "./hent-og-lagre-miljøvariabler.sh",
        "build": "pnpm build:prod",
        "build:dev": "NODE_ENV=development pnpm build:backend && pnpm build:frontend --mode lokalt-mot-preprod",
        "build:preprod": "NODE_ENV=production pnpm build:backend && pnpm build:frontend --mode preprod",
        "build:prod": "NODE_ENV=production pnpm build:backend && pnpm build:frontend --mode prod",
        "build:backend": "tsc -p src/backend/tsconfig.json && node scripts/prune-backend-node-modules.js",
        "build:frontend": "vite build src/frontend",
        "test": "pnpm test:backend && pnpm test:frontend",
        "test:backend": "vitest --config src/backend/vitest.config.ts --run",
        "test:frontend": "vitest --config src/frontend/vitest.config.ts --run",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "prepare": "husky",
        "typecheck": "tsc --noEmit -p src/backend/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json",
        "validate": "pnpm typecheck && pnpm check"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx,css}": [
            "biome check ."
        ]
    },
    "dependencies": {
        "@dotenvx/dotenvx": "2.30.0",
        "@nais/apm": "0.7.2",
        "@navikt/aksel-icons": "8.16.2",
        "@navikt/ds-css": "8.16.2",
        "@navikt/ds-react": "8.16.2",
        "@navikt/ds-tokens": "8.16.2",
        "@navikt/familie-backend": "11.0.0",
        "@navikt/familie-form-elements": "22.0.3",
        "@navikt/familie-header": "17.0.5",
        "@navikt/familie-http": "8.0.26",
        "@navikt/familie-ikoner": "9.1.6",
        "@navikt/familie-logging": "7.0.9",
        "@navikt/familie-skjema": "8.2.52",
        "@navikt/familie-tidslinje": "11.0.5",
        "@navikt/familie-typer": "8.0.7",
        "@navikt/flagg-ikoner": "15.1.13",
        "@navikt/fnrvalidator": "2.2.1",
        "@navikt/land-verktoy": "15.1.13",
        "@navikt/pino-logger": "5.0.1",
        "@tanstack/react-query": "5.103.2",
        "@tanstack/react-query-devtools": "5.103.2",
        "@tanstack/react-virtual": "3.14.13",
        "axios": "1.20.0",
        "classnames": "2.5.1",
        "clsx": "2.1.1",
        "date-fns": "4.4.0",
        "dayjs": "1.11.23",
        "deep-equal": "2.2.3",
        "express": "5.2.1",
        "http-proxy-middleware": "4.2.0",
        "lodash": "4.18.1",
        "pino": "10.3.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "7.88.0",
        "react-router": "8.4.0",
        "styled-components": "6.5.3",
        "tslib": "2.8.1",
        "uuid": "14.0.2"
    },
    "devDependencies": {
        "@axe-core/react": "4.13.0",
        "@biomejs/biome": "2.5.14",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/deep-equal": "1.0.4",
        "@types/express": "5.0.6",
        "@types/node": "24.19.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vercel/nft": "1.11.0",
        "@vitejs/plugin-react": "6.1.1",
        "husky": "9.1.7",
        "jsdom": "30.1.1",
        "lint-staged": "17.5.1",
        "msw": "2.15.0",
        "pino-pretty": "13.1.3",
        "typescript": "7.0.2",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    }
}
