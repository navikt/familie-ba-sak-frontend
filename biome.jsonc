{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    // Biome sjekker bare filene som er listet her: fra 2.6 formaterer Biome også YAML-filene i .nais, og det ødela deploy.
    "files": {
        "includes": [
            "src/**",
            "playwright/**",
            "playwright.config.ts",
            "scripts/**",
            "assets/**",
            ".vscode/**",
            "package.json",
            "tsconfig.base.json",
            "biome.jsonc"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "useExhaustiveDependencies": "warn",
                "useJsxKeyInIterable": "warn"
            },
            "suspicious": {
                "noDoubleEquals": "warn",
                "noArrayIndexKey": "warn",
                "useIterableCallbackReturn": "warn"
            }
        }
    },
    "javascript": {
        "formatter": {
            "trailingCommas": "es5",
            "arrowParentheses": "asNeeded",
            "quoteStyle": "single"
        }
    },
    "html": {
        "parser": {
            "interpolation": true
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/tsconfig*.json"],
            "json": {
                "parser": {
                    "allowComments": true,
                    "allowTrailingCommas": true
                }
            }
        }
    ]
}
